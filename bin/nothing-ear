#!/usr/bin/env python3
"""
Nothing Ear Linux Controller
Universal driver for Nothing Ear (1, 2, 3, (a), Open) & CMF Buds.
Supports ANC, EQ, Bass Enhance, Spatial Audio, Dual Connect, Gaming Mode, In-Ear & Audio Routing.
"""

import sys
import os
import json
import socket
import subprocess
import time
import re

CONFIG_PATH = os.path.expanduser("~/.config/nothing-ear/config.json")
RFCOMM_CHANNEL = 15

COMMANDS = {
    # ANC Modes (Verified)
    "ANC_HIGH": bytes.fromhex("5560010ff00300cf010100e66f"),
    "ANC_MID": bytes.fromhex("5560010ff00300d5010200e69f"),
    "ANC_LOW": bytes.fromhex("5560010ff00300d7010300e70f"),
    "ANC_ADAPTIVE": bytes.fromhex("5560010ff00300dd010400e53f"),
    "ANC_TRANSPARENCY": bytes.fromhex("5560010ff00300cb010700c5af"),
    "ANC_OFF": bytes.fromhex("5560010ff00300cd010500c447"),
    
    # Equalizer DSP Presets (Verified with hardware ACK)
    "EQ_BALANCED": bytes.fromhex("55600110f0020001000027a9"),
    "EQ_BASS": bytes.fromhex("55600110f002000101002639"),
    "EQ_TREBLE": bytes.fromhex("55600110f0020001020026c9"),
    "EQ_VOICE": bytes.fromhex("55600110f002000103002759"),

    # Spatial Audio (Captured from Nothing X)
    "SPATIAL_OFF": bytes.fromhex("5560011ff0010001009d5d"),
    "SPATIAL_FIXED": bytes.fromhex("5560011ff0010001015c9d"),

    # Bass Enhance / Ultra Bass (Captured from Nothing X)
    "BASS_OFF": bytes.fromhex("55600162f00200010100743e"),
    "BASS_LVL1": bytes.fromhex("55600162f00200010101b5fe"),
    "BASS_LVL2": bytes.fromhex("55600162f0020001010274fe"),
    "BASS_LVL3": bytes.fromhex("55600162f00200010103343f"),
    "BASS_LVL4": bytes.fromhex("55600162f00200010104f5fe"),
    "BASS_LVL5": bytes.fromhex("55600162f00200010105b43d"),

    # Dual Connection (Captured from Nothing X)
    "DUAL_CONNECT_ON": bytes.fromhex("5560014ff00200010100893c"),
    "DUAL_CONNECT_OFF": bytes.fromhex("5560014ff0020001000088ac"),

    # Feature Toggles (Low Latency & In-Ear)
    "LOW_LATENCY_ON": bytes.fromhex("55600140f00200010100763c"),
    "LOW_LATENCY_OFF": bytes.fromhex("55600140f0020001020076cc"),
    "IN_EAR_ON": bytes.fromhex("55600104f003000101010179a4"),
    "IN_EAR_OFF": bytes.fromhex("55600104f0030001010100b864"),
}

DEFAULT_CONFIG = {
    "active_anc": "ANC_HIGH",
    "active_eq": "EQ_BALANCED",
    "spatial_audio": "SPATIAL_OFF",
    "bass_enhance": "BASS_OFF",
    "dual_connect": True,
    "game_mode": False,
    "in_ear": True,
    "auto_audio_switch": True,
    "restore_profile_on_connect": True,
    "notifications": True,
}

def load_config():
    if not os.path.exists(CONFIG_PATH):
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG.copy()
    try:
        with open(CONFIG_PATH, "r") as f:
            data = json.load(f)
            merged = DEFAULT_CONFIG.copy()
            merged.update(data)
            return merged
    except Exception:
        return DEFAULT_CONFIG.copy()

def save_config(config_dict):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump(config_dict, f, indent=2)

def get_device_mac():
    try:
        out = subprocess.check_output(["bluetoothctl", "devices"], text=True)
        for line in out.strip().splitlines():
            parts = line.split(" ", 2)
            if len(parts) >= 3:
                mac = parts[1]
                name = parts[2].lower()
                if "nothing ear" in name or "ear (" in name or "cmf" in name:
                    return mac
        for line in out.strip().splitlines():
            parts = line.split(" ", 2)
            if len(parts) >= 3:
                mac = parts[1]
                try:
                    info = subprocess.check_output(["bluetoothctl", "info", mac], text=True)
                    if "Connected: yes" in info:
                        return mac
                except Exception:
                    pass
    except Exception:
        pass
    return None

def is_device_connected(mac=None):
    if not mac:
        mac = get_device_mac()
    if not mac:
        return False
    try:
        out = subprocess.check_output(["bluetoothctl", "info", mac], text=True)
        return "Connected: yes" in out
    except Exception:
        return False

def parse_composite_telemetry(raw_bytes):
    idx = 0
    res = {}
    while idx < len(raw_bytes) - 4:
        if raw_bytes[idx] == 0x55 and raw_bytes[idx+1] == 0x60 and raw_bytes[idx+2] == 0x01:
            cmd = raw_bytes[idx+3]
            pkt_type = raw_bytes[idx+4]
            if pkt_type == 0xe0 and idx + 8 < len(raw_bytes):
                count = raw_bytes[idx+8]
                p = idx + 9
                for _ in range(count):
                    if p + 1 < len(raw_bytes):
                        eid = raw_bytes[p]
                        eval_ = raw_bytes[p+1]
                        p += 2
                        is_chg = bool(eval_ & 0x80)
                        val = eval_ & 0x7f
                        if eid not in res or (val > 5 and not is_chg):
                            res[eid] = {"val": val, "charging": is_chg, "raw": eval_}
            idx += 6
        else:
            idx += 1
    return res

def query_live_battery_rfcomm(mac):
    l_pct, r_pct, c_pct = None, None, None
    l_chg, r_chg, c_chg = False, False, False

    try:
        sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
        sock.settimeout(0.4)
        sock.connect((mac, RFCOMM_CHANNEL))

        for op in [0x01, 0x02]:
            try:
                sock.sendall(bytes([0x55, 0x60, 0x01, op, 0xf0, 0x00, 0x00, 0x00]))
                time.sleep(0.04)
                data = sock.recv(128)
                parsed = parse_composite_telemetry(data)
                if 2 in parsed and parsed[2]["val"] > 5:
                    l_pct = parsed[2]["val"]
                    l_chg = parsed[2]["charging"]
                if 3 in parsed and parsed[3]["val"] > 5:
                    r_pct = parsed[3]["val"]
                    r_chg = parsed[3]["charging"]
                if 4 in parsed and parsed[4]["val"] > 0:
                    c_pct = parsed[4]["val"]
                    c_chg = parsed[4]["charging"]
            except Exception:
                pass

        sock.close()
    except Exception:
        pass

    return l_pct, l_chg, r_pct, r_chg, c_pct, c_chg

def get_detailed_battery(mac=None):
    if not mac:
        mac = get_device_mac()
    if not mac:
        return None

    # 1. Fast Pair ServiceData (Fastest 0ms lookup)
    l_pct, r_pct, c_pct = None, None, None
    l_chg, r_chg, c_chg = False, False, False

    try:
        out = subprocess.check_output(["bluetoothctl", "info", mac], text=True)
        m = re.search(r"ServiceData Key: 0000fe2c[^\n]*\n\s*ServiceData Value:\s*\n\s*([0-9a-fA-F ]+)", out)
        if m:
            hex_str = m.group(1).replace(" ", "").strip()
            raw = bytes.fromhex(hex_str)
            if len(raw) >= 3:
                b_left = raw[-3]
                b_right = raw[-2]
                b_case = raw[-1]

                if b_left != 0x7f:
                    l_pct = b_left & 0x7f
                    l_chg = bool(b_left & 0x80)

                if b_right != 0x7f:
                    r_pct = b_right & 0x7f
                    r_chg = bool(b_right & 0x80)

                if b_case != 0x7f:
                    c_pct = b_case & 0x7f
                    c_chg = bool(b_case & 0x80)
    except Exception:
        pass

    # 2. RFCOMM Composite Telemetry if connected and values need refinement
    if is_device_connected(mac):
        try:
            rl, rlc, rr, rrc, rc, rcc = query_live_battery_rfcomm(mac)
            if rl is not None: l_pct, l_chg = rl, rlc
            if rr is not None: r_pct, r_chg = rr, rrc
            if rc is not None: c_pct, c_chg = rc, rcc
        except Exception:
            pass

    summary_parts = []
    if l_pct is not None:
        summary_parts.append(f"L: {l_pct}%{'⚡' if l_chg else ''}")
    if r_pct is not None:
        summary_parts.append(f"R: {r_pct}%{'⚡' if r_chg else ''}")
    if c_pct is not None:
        summary_parts.append(f"C: {c_pct}%{'⚡' if c_chg else ''}")

    summary = " • ".join(summary_parts) if summary_parts else None

    return {
        "left": l_pct,
        "left_charging": l_chg,
        "right": r_pct,
        "right_charging": r_chg,
        "case": c_pct,
        "case_charging": c_chg,
        "has_case": (c_pct is not None),
        "summary": summary,
    }

def get_active_codec(mac=None):
    try:
        out = subprocess.check_output(["pactl", "list", "sinks"], text=True)
        for block in out.split("Sink #"):
            if "bluez_output" in block or (mac and mac.replace(":", "_") in block):
                for line in block.splitlines():
                    if "api.bluez5.codec" in line or "bluetooth.codec" in line:
                        parts = line.split("=")
                        if len(parts) >= 2:
                            codec = parts[1].strip().replace('"', '').upper()
                            return codec
    except Exception:
        pass
    return None

def get_bluetooth_audio_sink(mac=None):
    if not mac:
        mac = get_device_mac()
    mac_clean = mac.replace(":", "_") if mac else ""
    try:
        out = subprocess.check_output(["pactl", "list", "short", "sinks"], text=True)
        for line in out.strip().splitlines():
            parts = line.split()
            if len(parts) >= 2:
                sink_name = parts[1]
                if "bluez_output" in sink_name or (mac_clean and mac_clean in sink_name):
                    return sink_name
    except Exception:
        pass
    return None

def is_bluetooth_audio_active():
    try:
        out = subprocess.check_output(["pactl", "get-default-sink"], text=True).strip()
        return "bluez_output" in out
    except Exception:
        return False

def set_bluetooth_audio_output(mac=None):
    if not mac:
        mac = get_device_mac()
    sink = get_bluetooth_audio_sink(mac)
    if not sink and mac:
        try:
            subprocess.run(["bluetoothctl", "connect", mac], timeout=3.0, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.6)
            sink = get_bluetooth_audio_sink(mac)
        except Exception:
            pass

    if sink:
        try:
            subprocess.run(["pactl", "set-default-sink", sink], check=True)
            try:
                inputs = subprocess.check_output(["pactl", "list", "short", "sink-inputs"], text=True)
                for line in inputs.strip().splitlines():
                    parts = line.split()
                    if parts:
                        subprocess.run(["pactl", "move-sink-input", parts[0], sink], stderr=subprocess.DEVNULL)
            except Exception:
                pass
            return True, sink
        except Exception as e:
            return False, str(e)
    return False, "Bluetooth audio sink not found (Device connecting...)"

def get_status_dict():
    mac = get_device_mac()
    connected = is_device_connected(mac)
    audio_active = is_bluetooth_audio_active() if connected else False
    battery = get_detailed_battery(mac) if connected else None
    codec = get_active_codec(mac) if connected else None
    cfg = load_config()
    return {
        "connected": connected,
        "mac": mac,
        "battery": battery,
        "codec": codec,
        "audio_active": audio_active,
        "active_anc": cfg.get("active_anc", "ANC_HIGH"),
        "active_eq": cfg.get("active_eq", "EQ_BALANCED"),
        "spatial_audio": cfg.get("spatial_audio", "SPATIAL_OFF"),
        "bass_enhance": cfg.get("bass_enhance", "BASS_OFF"),
        "dual_connect": cfg.get("dual_connect", True),
        "game_mode": cfg.get("game_mode", False),
        "in_ear": cfg.get("in_ear", True),
        "auto_audio_switch": cfg.get("auto_audio_switch", True),
        "restore_profile_on_connect": cfg.get("restore_profile_on_connect", True),
        "notifications": cfg.get("notifications", True),
    }

def send_command(command_key, mac=None):
    if not mac:
        mac = get_device_mac()
    if not mac:
        return False, "No Nothing or CMF earbuds detected"

    cmd = COMMANDS.get(command_key)
    if not cmd:
        return False, "Unknown command"

    sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_STREAM, socket.BTPROTO_RFCOMM)
    sock.settimeout(2.5)
    try:
        sock.connect((mac, RFCOMM_CHANNEL))
        sock.sendall(cmd)
        try:
            sock.settimeout(1.0)
            ack = sock.recv(64)
        except Exception:
            pass
        return True, "Success"
    except Exception as e:
        return False, str(e)
    finally:
        try:
            sock.close()
        except Exception:
            pass

def restore_profile():
    if not is_device_connected():
        return False, "Device not connected"
    cfg = load_config()
    if cfg.get("restore_profile_on_connect", True):
        anc = cfg.get("active_anc", "ANC_HIGH")
        send_command(anc)
        eq = cfg.get("active_eq", "EQ_BALANCED")
        send_command(eq)
        spatial = cfg.get("spatial_audio", "SPATIAL_OFF")
        if spatial != "SPATIAL_OFF":
            send_command(spatial)
        bass = cfg.get("bass_enhance", "BASS_OFF")
        if bass != "BASS_OFF":
            send_command(bass)
        if cfg.get("game_mode"):
            send_command("LOW_LATENCY_ON")
        if cfg.get("in_ear"):
            send_command("IN_EAR_ON")
    if cfg.get("auto_audio_switch", True):
        set_bluetooth_audio_output()
    return True, "Profile restored"

def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ["--status", "status", "-s"]:
            status = get_status_dict()
            print(json.dumps(status))
            sys.exit(0 if status["connected"] else 1)

        if arg in ["battery", "--battery"]:
            bat = get_detailed_battery()
            if bat and bat.get("summary"):
                print(f"🔋 {bat['summary']}")
            else:
                print("Battery status unavailable")
            sys.exit(0 if bat else 1)

        if arg in ["switch-audio", "audio-switch", "set-audio"]:
            ok, msg = set_bluetooth_audio_output()
            if ok:
                print("✓ Switched default audio sink to Nothing Ear")
            else:
                print(f"❌ Error: {msg}")
            sys.exit(0 if ok else 1)

        if arg in ["restore", "sync-profile"]:
            ok, msg = restore_profile()
            if ok:
                print("✓ Restored user profile & audio routing")
            else:
                print(f"❌ Error: {msg}")
            sys.exit(0 if ok else 1)

        mapping = {
            # ANC
            "high": ("ANC_HIGH", "active_anc"),
            "mid": ("ANC_MID", "active_anc"),
            "low": ("ANC_LOW", "active_anc"),
            "adaptive": ("ANC_ADAPTIVE", "active_anc"),
            "transparency": ("ANC_TRANSPARENCY", "active_anc"),
            "trans": ("ANC_TRANSPARENCY", "active_anc"),
            "off": ("ANC_OFF", "active_anc"),
            
            # EQ
            "eq-balanced": ("EQ_BALANCED", "active_eq"),
            "eq-bass": ("EQ_BASS", "active_eq"),
            "eq-treble": ("EQ_TREBLE", "active_eq"),
            "eq-voice": ("EQ_VOICE", "active_eq"),

            # Spatial Audio
            "spatial-off": ("SPATIAL_OFF", "spatial_audio"),
            "spatial-on": ("SPATIAL_FIXED", "spatial_audio"),
            "spatial-fixed": ("SPATIAL_FIXED", "spatial_audio"),

            # Bass Enhance
            "bass-off": ("BASS_OFF", "bass_enhance"),
            "bass-1": ("BASS_LVL1", "bass_enhance"),
            "bass-2": ("BASS_LVL2", "bass_enhance"),
            "bass-3": ("BASS_LVL3", "bass_enhance"),
            "bass-4": ("BASS_LVL4", "bass_enhance"),
            "bass-5": ("BASS_LVL5", "bass_enhance"),

            # Dual Connect
            "dual-on": ("DUAL_CONNECT_ON", "dual_connect", True),
            "dual-off": ("DUAL_CONNECT_OFF", "dual_connect", False),

            # Gaming & In-Ear
            "game-on": ("LOW_LATENCY_ON", "game_mode", True),
            "game-off": ("LOW_LATENCY_OFF", "game_mode", False),
            "in-ear-on": ("IN_EAR_ON", "in_ear", True),
            "in-ear-off": ("IN_EAR_OFF", "in_ear", False),
            
            # Preferences
            "auto-audio-on": ("auto_audio_switch", True),
            "auto-audio-off": ("auto_audio_switch", False),
            "restore-profile-on": ("restore_profile_on_connect", True),
            "restore-profile-off": ("restore_profile_on_connect", False),
            "notif-on": ("notifications", True),
            "notif-off": ("notifications", False),
        }
        entry = mapping.get(arg)
        if entry:
            cfg = load_config()
            if len(entry) == 2 and isinstance(entry[1], bool):
                cfg[entry[0]] = entry[1]
                save_config(cfg)
                print(f"✓ Setting '{entry[0]}' updated to {entry[1]}")
                sys.exit(0)
            else:
                cmd = entry[0]
                success, msg = send_command(cmd)
                if success:
                    if len(entry) >= 3 and isinstance(entry[2], bool):
                        cfg[entry[1]] = entry[2]
                    else:
                        cfg[entry[1]] = cmd
                    save_config(cfg)
                    print(f"✓ Command '{arg}' sent successfully")
                else:
                    if len(entry) >= 3 and isinstance(entry[2], bool):
                        cfg[entry[1]] = entry[2]
                    else:
                        cfg[entry[1]] = cmd
                    save_config(cfg)
                    print(f"⚠️ Preference '{arg}' saved (Device status: {msg})")
                sys.exit(0 if success else 1)
        else:
            print("Usage: nothing-ear [command]")
            sys.exit(1)
    else:
        print("Nothing Ear CLI Controller")
        print("Usage: nothing-ear [command]")

if __name__ == '__main__':
    main()
